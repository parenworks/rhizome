(:format 1
 :name "tokyo-night"
 :roles (:background "#1a1b26"
         :foreground "#c0caf5"
         :accent "#7aa2f7"
         :muted "#565f89"
         :focus :accent
         :unfocus "#404040"
         :hairline "#3b4261"
         :surface "#23142d"
         :surface-foreground "#aa96c8"
         :surface-border "#4a3a66"
         :selection "#503278"
         :selection-foreground "#f0e6ff"
         :match :accent
         :error "#f7768e"
         :shadow "#1e1e24")
 :elements (:launcher-prompt "#8c64aa"
            :launcher-query "#dcc8f0"
            :launcher-cursor "#b4a0d2"
            :launcher-placeholder "#6b5a8a"
            :menu-background "#1f1633"
            :menu-border "#4a3a72"
            :menu-item "#c9b8e8"
            :menu-hover-background "#4b3a78"))
