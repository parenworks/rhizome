(asdf:defsystem #:rhizome
  :version "0.1.0"
  :description "StumpWM-style window manager for the River Wayland compositor"
  :author "Glenn Thompson"
  :license "AGPL-3.0"
  :depends-on (#:wayflan-client
               #:cl-ppcre
               #:bordeaux-threads
               #:cffi
               #:pngload)
  :components
  ((:file "river-protocol")
   (:file "package" :depends-on ("river-protocol"))
   (:file "config" :depends-on ("package"))
   (:file "sources" :depends-on ("config"))
   (:file "theme" :depends-on ("config"))
   (:file "modules" :depends-on ("config" "sources"))
   (:file "hooks" :depends-on ("package"))
   (:file "launch" :depends-on ("package"))
   (:file "surface" :depends-on ("package"))
   (:file "session" :depends-on ("package" "config" "hooks" "launch"))
   (:file "wm-protocol" :depends-on ("package" "config" "launch"))
   (:file "display" :depends-on ("wm-protocol" "message"))
   (:file "window" :depends-on ("wm-protocol"))
   (:file "output" :depends-on ("wm-protocol"))
   (:file "seat" :depends-on ("wm-protocol"))
   (:file "input" :depends-on ("wm-protocol"))
   (:file "floating" :depends-on ("window" "output" "seat" "animate" "theme"))
   (:file "wse" :depends-on ("window"))
   (:file "frames" :depends-on ("window" "output" "seat" "animate" "theme"))
   (:file "workspaces" :depends-on ("window" "output" "seat" "floating" "frames" "animate"))
   (:file "placement" :depends-on ("window" "frames" "workspaces"))
   (:file "takeover" :depends-on ("workspaces" "floating" "frames"))
   (:file "tiling" :depends-on ("window" "output" "seat" "workspaces" "floating" "frames"))
   (:file "scroll" :depends-on ("tiling" "bar" "theme"))
   (:file "groups" :depends-on ("scroll" "workspaces" "floating" "frames"))
   (:file "dbus" :depends-on ("wm-protocol" "config"))
   (:file "font" :depends-on ("package" "config"))
   (:file "tray" :depends-on ("dbus"))
   (:file "keys" :depends-on ("package"))
   (:file "keymap" :depends-on ("keys"))
   (:file "keybindings" :depends-on ("tiling" "keymap"))
   (:file "animate" :depends-on ("window" "config"))
   (:file "launcher" :depends-on ("keybindings" "font" "theme"))
   (:file "prompt" :depends-on ("bar" "workspaces" "theme"))
   (:file "message" :depends-on ("bar" "theme"))
   (:file "prompt-clients" :depends-on ("prompt" "message" "ipc"))
   (:file "prefix" :depends-on ("prompt-clients" "keybindings" "scroll" "groups"))
   (:file "expose" :depends-on ("prefix" "floating" "frames"))
   (:file "menus" :depends-on ("expose" "animate" "theme"))
   (:file "decorations" :depends-on ("floating" "animate" "theme"))
   (:file "eval-prompt" :depends-on ("keybindings" "bar" "theme"))
   (:file "bar" :depends-on ("launcher" "config" "wm-protocol" "theme"))
   (:file "commands" :depends-on ("keybindings" "launcher" "scroll" "groups" "display"))
   (:file "ipc" :depends-on ("commands" "message"))
   (:file "main" :depends-on ("commands" "bar" "ipc"))))
